{
  "mcpServers": {
    "workspace": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/launch.sh",
      "env": {
        "GWM_TOOLS": "${user_config.tools}",
        "GWM_CREDENTIAL_COMMAND": "${user_config.credential_command}",
        "GWM_CLIENT_ID": "${user_config.client_id}",
        "GWM_CLIENT_SECRET": "${user_config.client_secret}",
        "GWM_EMAIL": "${user_config.email}"
      }
    }
  }
}
