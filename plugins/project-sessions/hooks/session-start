#!/usr/bin/env bash
# SessionStart: create or resume this repo's project session, detached, and name it in one
# line of context. Auto mode only (hooks/lib.sh auto_on); otherwise it only names it.
#
# The input carries no permission_mode (measured 2.1.330, -p, startup), so a session that does
# not exist yet is created by the first prompt (hooks/user-prompt-submit), which has the mode.
# A stopped one is resumed here: resume is bare and keeps its own mode.
#
# Fails open and stays silent: outside git, without jq, in a background session (the project
# session itself must not be told to delegate to itself), on any error, or past the 2 s bound.
set -u
exec 2>/dev/null # quiet means empty stderr too (bash 3.2 reports a killed job there)
command -v jq >/dev/null 2>&1 || exit 0
input=$(cat 2>/dev/null) || exit 0
cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
sid=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null)
pmode=$(printf '%s' "$input" | jq -r '.permission_mode // empty' 2>/dev/null)
[ -n "$cwd" ] || cwd=$PWD
git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 || exit 0

HERE=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$HERE/lib.sh" || exit 0

bounded_status "$cwd" "$sid" || exit 0
case $LINE in background\ *) exit 0 ;; esac
name=${LINE% *}
state=${LINE##* }
[ -n "${CLAUDE_CODE_TASK_LIST_ID:-}" ] && [ "$CLAUDE_CODE_TASK_LIST_ID" = "$name" ] && exit 0 # a session ensure created

if ! auto_on; then
  if [ "$state" = none ]; then
    msg="project-sessions: this repo has no project session yet (name \`$name\`). Before multi-step work here, load the \`project-sessions\` skill."
  else
    msg="project-sessions: this repo's project session is \`$name\` ($state). Before multi-step work here, load the \`project-sessions\` skill."
  fi
  emit SessionStart "$msg"
  exit 0
fi

mode=$(mirror_mode "$pmode")
start_ensure "$cwd" "$name" "$state" "$mode"
if [ -n "$WHY" ]; then
  emit SessionStart "project-sessions: this repo's project session \`$name\` could not start: $WHY"
  exit 0
fi
[ "$SHOWN" = none ] && SHOWN="not started; your first prompt starts it"
emit SessionStart "project-sessions: this repo's project session is \`$name\` ($SHOWN). Hand multi-step work to it with SendMessage to \`$name\`; keep only coordination here."
