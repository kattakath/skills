{
  "description": "Kattakath Workspace: confirm argument-dependent writes (write-guard); search_corpus gated by locator_mode and reduced to a locator table",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__workspace_search_corpus$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/corpus-locator.js", "gate"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Kattakath: cross-app search gate"
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(calendar_create_event|calendar_delete_event|calendar_respond_to_event|calendar_update_event|chat_mark_as_read|chat_mark_as_unread|chat_send_message|chat_update_notification_settings|contacts_manage_contact|contacts_manage_contact_group|contacts_manage_contacts_batch|docs_update_doc|drive_copy_file|drive_create_file|forms_batch_update_form|forms_set_publish_settings|gmail_apply_sensitive_message_label|gmail_apply_sensitive_thread_label|gmail_label_message|gmail_label_thread|gmail_mark_message_spam|gmail_mark_thread_spam|gmail_trash_message|gmail_trash_thread|gmail_unlabel_message|gmail_unlabel_thread|gmail_unmark_message_spam|gmail_unmark_thread_spam|gmail_untrash_message|gmail_untrash_thread|gmail_update_message_labels|portal_toggle_single_server|sheets_insert_dimension|sheets_update_formulas|sheets_update_spreadsheet|sheets_update_values|slides_update_presentation|tasks_manage_task|tasks_manage_task_list)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/write-guard.js"],
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Kattakath: checking write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.+__workspace_search_corpus$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/corpus-locator.js", "reduce"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
