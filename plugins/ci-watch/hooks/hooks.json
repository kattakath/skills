{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/ci-watch.js\" --hook",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
